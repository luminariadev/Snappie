{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES6"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "declaration": true,
    "downlevelIteration": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["node_modules"]
}